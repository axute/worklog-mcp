# Copy to .env next to compose.yaml (not tracked).

# public host name Traefik routes to the server
WORKLOG_HOST=worklog.example.com
# existing Docker network Traefik uses to reach containers
TRAEFIK_NETWORK=traefik
# data directory on the host (SQLite file + backups); owned by 99:100 on Unraid
WORKLOG_DATA=/srv/worklog-mcp
# only when building from the checkout (see compose.yaml): this repository, absolute path if the stack lives elsewhere
WORKLOG_SRC=.
# display time zone
WORKLOG_TZ=Europe/Berlin
# optional: sign-in for the web view through a reverse proxy; random, min. 24 characters
# (e.g. openssl rand -base64 32)
# WORKLOG_PROXY_SECRET=
